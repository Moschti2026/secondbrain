# Postgres connection string (Supabase project, or any Postgres with the
# `vector` extension installable). Supabase: Project Settings -> Database ->
# Connection string ("URI", use the pooled "Transaction" one for serverless).
DATABASE_URL="postgresql://postgres:password@host:5432/postgres"

# Auth.js session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Enable the "Google Drive API". Authorized redirect URI:
# https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID (Azure) app registration -> Certificates & secrets.
# Redirect URI: https://<your-domain>/api/auth/callback/microsoft-entra-id
# Leave AUTH_MICROSOFT_ENTRA_ID_ISSUER unset to allow any Microsoft account
# (personal + work/school); set it to restrict sign-in to one tenant:
# https://login.microsoftonline.com/<tenant-id>/v2.0/
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Used by src/lib/oauth.ts when refreshing a Microsoft token in the
# background (cron sync). Only needed if you set the issuer above to a
# specific tenant instead of "common".
AUTH_MICROSOFT_ENTRA_ID_TENANT="common"

# Anthropic (Claude) API key for chat answers: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Voyage AI API key for embeddings: https://dash.voyageai.com/
VOYAGE_API_KEY=""

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# calling /api/cron/sync. Generate with: openssl rand -hex 32
CRON_SECRET=""
